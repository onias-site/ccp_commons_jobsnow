<aspectj>

    <weaver options="-verbose -showWeaveInfo">
        <include within="com.ccp..*"/>
        <include within="com.jn..*"/>
        <include within="com.jb..*"/>
        <include within="com.vis..*"/>
        <exclude within="com.ccp.aop..*"/>
    </weaver>

    <aspects>
        <aspect name="com.ccp.aop.CcpNullParameterAspect"/>
        <aspect name="com.ccp.aop.CcpNullReturnAspect"/>
        <aspect name="com.ccp.aop.CcpSoftExceptionAspect"/>
    </aspects>

</aspectj>
